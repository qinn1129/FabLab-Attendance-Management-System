# ── MongoDB ─────────────────────────────────────────────────────────
# Local MongoDB (via MongoDB Community Server or Docker):
MONGODB_URI="mongodb://127.0.0.1:27017/fablab"
# Or MongoDB Atlas (free tier) — paste your connection string instead:
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fablab?retryWrites=true&w=majority"

# ── Server ──────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed origins for CORS. The Vite dev server
# default is http://localhost:5173.
CORS_ORIGIN="http://localhost:5173"

# ── Auth ────────────────────────────────────────────────────────────
# Same shared-secret model as the old Apps Script backend (VITE_WEBAPP_SECRET
# in the React app's .env must match this exactly).
WEBAPP_SECRET="7893402haefudHJFKio&%^*(#G2ghd0"

# ── Migration only (migrate.js) ────────────────────────────────────
# Your EXISTING Apps Script deployment, used only to pull data out of
# Sheets during migration. Not used by the running server afterward.
LEGACY_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwODJl_Ihn9gIu3WCstBl1drKsiYOQoT3roYiQqJlgvIwY_KB3RjD79_q-2x-JcqlFJ/exec"
LEGACY_WEBAPP_SECRET="7893402haefudHJFKio&%^*(#G2ghd0"

# Path to a CSV export of the "accounts" sheet (File > Download > Comma
# Separated Values, from the SPECIFIC "accounts" tab) with passwordHash and
# salt columns intact. The public Apps Script endpoint always strips those
# two columns, even for authenticated callers, so there is no API-based way
# to migrate passwords — this manual export is the only way to preserve
# existing users' passwords instead of forcing everyone to re-register.
ACCOUNTS_CSV_PATH="./accounts_export.csv"
